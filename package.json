{
    "name": "lang-language",
    "displayName": "Lang language",
    "publisher": "dmezhnov",
    "description": "Syntax highlighting and basic structural validation for the Lang language.",
    "version": "0.3.6",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dmezhnov/lang"
    },
    "main": "out/extension/main.js",
    "engines": {
        "vscode": "^1.104.0"
    },
    "scripts": {
        "langium:generate": "langium generate",
        "build": "bun run langium:generate && node esbuild.js",
        "watch": "bun run langium:generate && node esbuild.js --watch",
        "test": "bun test"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "language",
        "syntax",
        "highlighting",
        "lang"
    ],
    "contributes": {
        "languages": [
            {
                "id": "lang",
                "aliases": [
                    "Lang",
                    "lang"
                ],
                "extensions": [
                    ".lang"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "lang",
                "scopeName": "source.lang",
                "path": "./syntaxes/lang.tmLanguage.json"
            }
        ]
    },
    "devDependencies": {
        "@eslint/js": "9.39.1",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@trunkio/launcher": "^1.3.4",
        "@types/bun": "^1.3.3",
        "@types/vscode": "1.104.0",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.2",
        "eslint": "9.39.1",
        "langium-cli": "^4.1.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.2",
    "trustedDependencies": [
        "@vscode/vsce-sign"
    ],
    "dependencies": {
        "langium": "^4.1.3",
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver": "^9.0.1"
    }
}
