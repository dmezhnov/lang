{
  "name": "lang",
  "scopeName": "source.lang",
  "fileTypes": [
    ".lang"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.lang",
      "match": "\\b(and|false|for|from|not|nothing|of|or|true|where)\\b"
    },
    {
      "name": "string.quoted.double.lang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "#",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.lang"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.lang"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.lang",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
