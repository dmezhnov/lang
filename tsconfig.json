{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "outDir": "vscode-extension/out",
        "rootDir": "vscode-extension/src",
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["vscode-extension/src"],
    "exclude": ["node_modules"]
}
