{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
                "--folder-uri=${workspaceFolder}/examples"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/out/**/*.js"
            ],
            "preLaunchTask": "build"
        }
    ]
}
