{
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "comment.line.number-sign",
                "settings": {
                    "foreground": "#6A9955"
                }
            },
            {
                "scope": "string.quoted.double",
                "settings": {
                    "foreground": "#CE9178"
                }
            },
            {
                "scope": "constant.numeric",
                "settings": {
                    "foreground": "#B5CEA8"
                }
            },
            {
                "scope": "entity.name.type",
                "settings": {
                    "foreground": "#4FC1FF",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "variable.name",
                "settings": {
                    "foreground": "#9CDCFE"
                }
            },
            {
                "scope": "entity.name.function",
                "settings": {
                    "foreground": "#DCDCAA",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "keyword.other",
                "settings": {
                    "foreground": "#C586C0",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "keyword.operator.assignment",
                    "keyword.operator.type.annotation"
                ],
                "settings": {
                    "foreground": "#FF0000",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "punctuation.parenthesis.open",
                    "punctuation.parenthesis.close",
                    "punctuation.separator.comma"
                ],
                "settings": {
                    "foreground": "#FFA500"
                }
            },
            {
                "scope": "keyword.operator.ellipsis",
                "settings": {
                    "foreground": "#FFCC00",
                    "fontStyle": "bold"
                }
            }
        ]
    }
}
