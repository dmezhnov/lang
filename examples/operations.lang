Market_participant_type = Gas_station_owner

Operation = multiply, divide
Condition = less_than, greater_or_equal_to
Axis = Region, District, Product_category, Product, Market_participant, Market_participant_type, Month_and_year

MatrixEl = {
    coords: c1, ... cn
        where
            c1: Coordinate
            ...
            cn: Coordinate
    value
}

CoordinateEl = {
    axis: Axis
    value
}

Coordinate = c1, ... cn
    where
        c1: CoordinateEl
        ...
        cn: CoordinateEl

Matrix = m1, ... mn
    where
        m1: MatrixEl
        ...
        mn: MatrixEl

# Операции с матрицами

## Служебные операции

### - Создать пустую матрицу по координатам ✅

new_empty(coordinates) = new_empty_matrix
    where
        new_empty_matrix: Matrix(a1, ... an)
        coordinates = c1, ... cn
            where
                c1, ... cn: Coordinate
                    where
                        c1.axis = a1
                        ...
                        cn.axis = an
                            where
                                a1, ... an: Axis

### - Создать без оси

new_empty_without_axis(matrix_source, axis_to_remove) = new_empty_matrix_without_axis
    where
        matrix_source: Matrix(axis_to_remove, ...TAxis)
        axis_to_remove: Axis
        new_empty_matrix_without_axis: Matrix(...TAxis)
            where
                TAxis: a1, ... an
                    where
                        a1, ... an: Axis

