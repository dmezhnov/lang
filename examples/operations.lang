### - Для каждого элемента

for_each_element(matrix_source, operation, value) = scaled_matrix
    where
        matrix_source: Matrix
        operation: Operation
        value: number
        scaled_matrix: Matrix

### - Фильтровать по значению

filter_by_value(matrix_source, condition, value) = filtered_matrix_by_value
    where
        matrix_source: Matrix
        condition: Condition
        value: number
        filtered_matrix_by_value: Matrix

### - Фильтровать по матрице

filter_by_pair(matrix_source, condition, matrix_condition) = filtered_matrix_by_pair
    where
        matrix_source: Matrix
        condition: Condition
        matrix_condition: Matrix
        filtered_matrix_by_pair: Matrix

### - Для каждой пары

for_each_pair(matrix_source_1, operation, matrix_source_2) = new_matrix
    where
        matrix_source_1: Matrix(...TAxis)
        matrix_source_2: Matrix
        operation: Operation
        new_matrix: Matrix(...TAxis)
            where
                TAxis: a1, ... an
                    where
                        a1: Axis
                        ...
                        an: Axis

### - Количество координат по оси

count_coordinates_by_axis(matrix_source, axis) = counted_matrix
    where
        matrix_source: Matrix
        axis: Axis
        counted_matrix: Matrix

### - Фильтровать по координате

filter_by_coordinate(matrix_source, coordinate) = filtered_matrix_by_coordinate
    where
        matrix_source: Matrix
        coordinate: Coordinate
        filtered_matrix_by_coordinate: Matrix

## Шаги алгоритма

### 0. Вычисляем суммарные объемы проливов по всем категориям НП в каждом регионе деятельности

volumes_by_district = sum_by_axis(volumes_by_period, District)
    where
        volumes_by_district: Matrix(Region, Product_category, Product, Market_participant)
        volumes_by_period: Matrix(Region, District, Product_category, Product, Market_participant)
            where
                Region, District, Product_category, Product, Market_participant: Axis

volumes_by_product_category_region = sum_by_axis(volumes_by_district, Product_category)
    where
        volumes_by_product_category_region: Matrix(Region, Product, Market_participant)
        volumes_by_district: Matrix(Region, Product_category, Product, Market_participant)
            where
                Region, Product_category, Product, Market_participant: Axis

### 1. Вычисляем суммарные запрашиваемые объемы по всем НПЗ и регионам поставки

requests_by_market_participant = sum_by_axis(requests_by_period, Market_participant)
    where
        requests_by_market_participant: Matrix(Product, Refinery, Region)
        requests_by_period: Matrix(Product, Refinery, Region, Market_participant)
            where
                Product, Refinery, Region, Market_participant: Axis

requests_by_market_participant_region = sum_by_axis(requests_by_market_participant, Region)
    where
        requests_by_market_participant_region: Matrix(Product, Refinery)
            where
                Product, Refinery, Region: Axis

### 2. Умножаем суммарные объемы проливов на переменную «Превышение Доступных объемов по Запросам»

volumes_scaled = for_each_element(requests_by_market_participant_region, multiply, OVERALL_REQUEST_CAPACITY_COEFFICIENT)
    where
        volumes_scaled: Matrix(Product, Refinery)
        multiply: Operation
        OVERALL_REQUEST_CAPACITY_COEFFICIENT: number = OVERALL_REQUEST_CAPACITY_PERCENTAGE/100
            where
                OVERALL_REQUEST_CAPACITY_PERCENTAGE: number = 120

### 3. Период дефицита

period_of_deficit = filter_by_pair(requests_by_market_participant_region, less_than, volumes_scaled)
    where
        period_of_deficit: Matrix(Product, Refinery)
        less_than: Condition

#### 3.1. Скользящее среднее

matrix_of_activity = count_coordinates_by_axis(volumes_by_product_category_region, Month_and_year)
    where
        matrix_of_activity: Matrix(Market_participant)
            where
                Market_participant, Month_and_year: Axis

moving_average = for_each_pair(volumes_by_product_category_region, divide, matrix_of_activity)
    where
        moving_average: Matrix(Region, Market_participant)
        divide: Operation

#### 3.2. Определяем количество НПЗ в запросах субъекта рынка (которые являются владельцами АЗС)

requests_by_gas_station_owner = filter_by_coordinate(requests_by_period, Gas_station_owner)
    where
        requests_by_gas_station_owner: Matrix(Product, Refinery, Region, Market_participant)
            where
                Product, Refinery, Region, Market_participant, Gas_station_owner: Axis

requests_count_refineries = count_coordinates_by_axis(requests_by_gas_station_owner, Refinery)
    where
        requests_count_refineries: Matrix(Market_participant, Refinery, Region, Product)
            where
                Market_participant, Refinery, Region, Product: Axis

